# Airflow Connections
REDIS_CONN_ID=redis_default
ELASTICSEARCH_CONN_ID=elasticsearch_default
SUNRISE_API_CONN_ID=sunrise_api_default

# Redis Stream Config - Common
STREAM_NAME=data_event_stream
GROUP_NAME=data_sync_consumer_group

# Redis Stream Sensor DAG
TRIGGERED_DAG_ID=redis_stream_processor_dag

# Redis Stream Processor DAG
CONSUMER_NAME_PROCESSOR=airflow_processor_consumer
PROCESS_BATCH_SIZE=100
BLOCK_TIMEOUT_MS=600000
MAX_WORKERS_FOR_MESSAGE_PROCESSING=2
ES_BULK_ACTIONS_THRESHOLD=50
ES_BULK_MAX_WAIT_SECONDS=10
REDIS_DATA_SYNC_DLQ_STREAM=data_sync_dlq_stream
DATA_INDEX_NAME=superb_platform_data_index

# Upload Data DAG
UPLOAD_DATA_ROOT_PATH=/app/input